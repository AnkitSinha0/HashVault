# Secrets and environment-specific connection strings.
# Copy this to .env and fill in real values. Never commit .env to git.
# Non-secret config (timeouts, pool sizes, TTLs) lives in config.yaml.

# Database — full connection string including credentials
DATABASE_DSN=postgres://hashvault:hashvault@localhost:5432/hashvault?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT signing secrets — use a random 64-character string in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# S3 / MinIO  (set S3_ENDPOINT blank + S3_USE_SSL=true for real AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=hashvault
S3_SECRET_ACCESS_KEY=hashvault123

# RabbitMQ — includes credentials in the URL
RABBITMQ_URL=amqp://hashvault:hashvault@localhost:5672/

# Google OAuth2 — create credentials at console.cloud.google.com
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
